{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EG-CO ERP",
  "version": "0.1.0",
  "identifier": "com.egco.erp",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EG-CO ERP",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.egco-erp.com/{{target}}-{{arch}}/{{current_version}}"],
      "pubkey": ""
    },
    "notification": {
      "all": true
    }
  }
}
