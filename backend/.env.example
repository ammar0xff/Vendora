DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/inventory_db
SECRET_KEY=change-this-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=./uploads

# Firebase Cloud Messaging (optional — for Android push notifications)
# Set to path of your firebase-service-account.json file
# FIREBASE_CREDENTIALS=/app/firebase-service-account.json

# Redis (optional — for multi-worker rate limiting)
# REDIS_URL=redis://redis:6379/0
