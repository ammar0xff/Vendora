{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": [
        "postgres-mcp",
        "--access-mode",
        "unrestricted",
        "postgresql://postgres:postgres@localhost:5432/inventory_db"
      ],
      "disabled": false,
      "autoApprove": [
        "run_query",
        "list_tables",
        "get_table_schema",
        "analyze_query",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql",
        "execute_sql"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:\\eg-co-erp"
      ],
      "disabled": false,
      "autoApprove": [
        "git_status",
        "git_log",
        "git_diff",
        "git_show",
        "git_branch"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch@latest"
      ],
      "disabled": false,
      "autoApprove": [
        "fetch"
      ]
    }
  }
}