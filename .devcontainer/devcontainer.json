{
  "name": "Vendora Beta Demo (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Vendora Web",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "docker compose -f docker-compose.demo.yml up -d --build",
  "postStartCommand": "docker compose -f docker-compose.demo.yml up -d",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint"],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  }
}